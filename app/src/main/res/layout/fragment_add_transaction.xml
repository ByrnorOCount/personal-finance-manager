<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO - type toggle + amount input -->
        <LinearLayout
            android:id="@+id/heroHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#6C63FF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="36dp">

            <!-- Back button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle_white_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_revert" />

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Thêm giao dịch"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

            </LinearLayout>

            <!-- Income / Expense toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/toggle_bg"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toggleExpense"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/toggle_selected_bg"
                    android:gravity="center"
                    android:text="Chi tiêu"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/toggleIncome"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Thu nhập"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Amount input -->
            <EditText
                android:id="@+id/amountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@null"
                android:gravity="center"
                android:hint="0"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <View
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="#80FFFFFF" />

        </LinearLayout>

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:background="@drawable/card_top_rounded"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="40dp">

            <!-- Category selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Danh mục"
                android:textColor="#888888"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/field_bg_light"
                android:paddingHorizontal="14dp" />

            <!-- Date picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Ngày"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/field_bg_light"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textColor="#1A1A1A"
                android:textSize="15sp" />

            <!-- Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Ghi chú (tuỳ chọn)"
                android:textColor="#888888"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/noteInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_bg_light"
                android:gravity="top"
                android:hint="Nhập ghi chú..."
                android:inputType="textMultiLine"
                android:lines="2"
                android:minHeight="52dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp" />

            <!-- Save button -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#6C63FF"
                android:text="Lưu giao dịch"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
