<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="100dp">

            <!-- ── TOP BAR ─────────────────────────────────────────── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    app:tint="?attr/colorOnBackground" />

                <TextView
                    android:id="@+id/tvDateRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_toEndOf="@id/btnMenu"
                    android:layout_toStartOf="@+id/llTopRightActions"
                    app:drawableEndCompat="@drawable/ic_arrow_downward"
                    android:drawablePadding="4dp"
                    app:drawableTint="?attr/colorOnBackground"
                    android:gravity="center"
                    android:text="@string/placeholder_date_range"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llTopRightActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnBackground" />

                    <ImageView
                        android:id="@+id/btnNotifications"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications"
                        app:tint="?attr/colorOnBackground" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ── DASHBOARD CARD ────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <!-- Initial Balance row -->
                    <TextView
                        android:id="@+id/tvInitialBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/initial_balance_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvInitialBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvInitialBalanceLabel"
                        app:layout_constraintStart_toEndOf="@id/tvInitialBalanceLabel"
                        tools:text="6.000.000 ₫" />

                    <!-- INCOME SECTION -->
                    <TextView
                        android:id="@+id/tvTotalIncomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/total_income_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvInitialBalanceLabel" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/income_green_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalIncomeLabel"
                        tools:text="6.500.000 ₫" />

                    <LinearLayout
                        android:id="@+id/incomeBarContainer"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="26dp"
                        android:background="@drawable/bg_bar_full"
                        android:backgroundTint="@color/chart_gray_bg"
                        android:clipToOutline="true"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toStartOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalIncome">

                        <View
                            android:id="@+id/incomeBarProvisional"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="30"
                            android:background="@color/provisional_blue" />

                        <View
                            android:id="@+id/incomeBarSpent"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="70"
                            android:background="@color/income_green_accent" />
                    </LinearLayout>

                    <!-- Green Pointer (Income Spent -> Total Income) -->
                    <View
                        android:id="@+id/vPointerIncomeGreen"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dashed_line_v"
                        android:backgroundTint="@color/income_green_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toTopOf="@id/incomeBarContainer"
                        app:layout_constraintEnd_toEndOf="@id/incomeBarContainer"
                        app:layout_constraintTop_toTopOf="@id/hPointerIncomeGreen" />

                    <View
                        android:id="@+id/hPointerIncomeGreen"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="-1dp"
                        android:background="@drawable/dashed_line_h"
                        android:backgroundTint="@color/income_green_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toBottomOf="@id/tvTotalIncome"
                        app:layout_constraintEnd_toStartOf="@id/vPointerIncomeGreen"
                        app:layout_constraintTop_toTopOf="@id/tvTotalIncome" />

                    <View
                        android:id="@+id/pointerHeadIncomeGreen"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="-3dp"
                        android:background="@drawable/pointer_dot"
                        android:backgroundTint="@color/income_green_accent"
                        app:layout_constraintBottom_toBottomOf="@id/hPointerIncomeGreen"
                        app:layout_constraintEnd_toStartOf="@id/hPointerIncomeGreen"
                        app:layout_constraintTop_toTopOf="@id/hPointerIncomeGreen" />

                    <!-- Blue Pointer (Provisional Balance) -->
                    <View
                        android:id="@+id/vPointerIncomeBlue"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/dashed_line_v"
                        android:backgroundTint="@color/provisional_blue"
                        android:layerType="software"
                        app:layout_constraintBottom_toTopOf="@id/hPointerIncomeBlue"
                        app:layout_constraintStart_toStartOf="@id/incomeBarContainer"
                        app:layout_constraintTop_toBottomOf="@id/incomeBarContainer" />

                    <View
                        android:id="@+id/hPointerIncomeBlue"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="-1dp"
                        android:background="@drawable/dashed_line_h"
                        android:backgroundTint="@color/provisional_blue"
                        android:layerType="software"
                        app:layout_constraintBottom_toBottomOf="@id/tvProvisionalBalance"
                        app:layout_constraintStart_toEndOf="@id/vPointerIncomeBlue"
                        app:layout_constraintTop_toTopOf="@id/tvProvisionalBalance" />

                    <View
                        android:id="@+id/pointerHeadIncomeBlue"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="-3dp"
                        android:background="@drawable/pointer_dot"
                        android:backgroundTint="@color/provisional_blue"
                        app:layout_constraintBottom_toBottomOf="@id/hPointerIncomeBlue"
                        app:layout_constraintStart_toEndOf="@id/hPointerIncomeBlue"
                        app:layout_constraintTop_toTopOf="@id/hPointerIncomeBlue" />

                    <TextView
                        android:id="@+id/tvProvisionalBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/provisional_balance_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/incomeBarContainer"
                        app:layout_constraintTop_toBottomOf="@id/incomeBarContainer" />

                    <TextView
                        android:id="@+id/tvProvisionalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/provisional_blue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvProvisionalBalanceLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvProvisionalBalanceLabel"
                        tools:text="874.000 ₫" />

                    <!-- BUDGET SECTION -->
                    <TextView
                        android:id="@+id/tvTotalBudgetedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/total_budgeted_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProvisionalBalance" />

                    <TextView
                        android:id="@+id/tvTotalBudgeted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/budget_purple_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalBudgetedLabel"
                        tools:text="5.626.000 ₫" />

                    <LinearLayout
                        android:id="@+id/budgetBarContainer"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="26dp"
                        android:background="@drawable/bg_bar_full"
                        android:backgroundTint="@color/chart_gray_bg"
                        android:clipToOutline="true"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toStartOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalBudgeted">

                        <View
                            android:id="@+id/budgetBarRemaining"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="30"
                            android:background="@color/budget_yellow_accent" />

                        <View
                            android:id="@+id/budgetBarSpent"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="70"
                            android:background="@color/budget_purple_accent" />
                    </LinearLayout>

                    <!-- Purple Pointer (Budget Spent -> Total Budgeted) -->
                    <View
                        android:id="@+id/vPointerBudgetPurple"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dashed_line_v"
                        android:backgroundTint="@color/budget_purple_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toTopOf="@id/budgetBarContainer"
                        app:layout_constraintEnd_toEndOf="@id/budgetBarContainer"
                        app:layout_constraintTop_toTopOf="@id/hPointerBudgetPurple" />

                    <View
                        android:id="@+id/hPointerBudgetPurple"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="-1dp"
                        android:background="@drawable/dashed_line_h"
                        android:backgroundTint="@color/budget_purple_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toBottomOf="@id/tvTotalBudgeted"
                        app:layout_constraintEnd_toStartOf="@id/vPointerBudgetPurple"
                        app:layout_constraintTop_toTopOf="@id/tvTotalBudgeted" />

                    <View
                        android:id="@+id/pointerHeadBudgetPurple"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="-3dp"
                        android:background="@drawable/pointer_dot"
                        android:backgroundTint="@color/budget_purple_accent"
                        app:layout_constraintBottom_toBottomOf="@id/hPointerBudgetPurple"
                        app:layout_constraintEnd_toStartOf="@id/hPointerBudgetPurple"
                        app:layout_constraintTop_toTopOf="@id/hPointerBudgetPurple" />

                    <!-- Yellow Pointer (Remaining) -->
                    <View
                        android:id="@+id/vPointerBudgetYellow"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/dashed_line_v"
                        android:backgroundTint="@color/budget_yellow_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toTopOf="@id/hPointerBudgetYellow"
                        app:layout_constraintStart_toStartOf="@id/budgetBarContainer"
                        app:layout_constraintTop_toBottomOf="@id/budgetBarContainer" />

                    <View
                        android:id="@+id/hPointerBudgetYellow"
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="-1dp"
                        android:background="@drawable/dashed_line_h"
                        android:backgroundTint="@color/budget_yellow_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toBottomOf="@id/tvRemaining"
                        app:layout_constraintStart_toEndOf="@id/vPointerBudgetYellow"
                        app:layout_constraintTop_toTopOf="@id/tvRemaining" />

                    <View
                        android:id="@+id/pointerHeadBudgetYellow"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="-3dp"
                        android:background="@drawable/pointer_dot"
                        android:backgroundTint="@color/budget_yellow_accent"
                        app:layout_constraintBottom_toBottomOf="@id/hPointerBudgetYellow"
                        app:layout_constraintStart_toEndOf="@id/hPointerBudgetYellow"
                        app:layout_constraintTop_toTopOf="@id/hPointerBudgetYellow" />

                    <TextView
                        android:id="@+id/tvRemainingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/remaining_to_spend_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/budgetBarContainer"
                        app:layout_constraintTop_toBottomOf="@id/budgetBarContainer" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/budget_yellow_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvRemainingLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvRemainingLabel"
                        tools:text="1.423.000 ₫" />

                    <!-- SAVING & CHART SECTION -->
                    <TextView
                        android:id="@+id/tvSavingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saving_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="@id/flChartContainer"
                        app:layout_constraintTop_toTopOf="@id/tvTotalIncomeLabel" />

                    <TextView
                        android:id="@+id/tvSaving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/saving_blue_accent"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvSavingLabel"
                        app:layout_constraintStart_toStartOf="@id/tvSavingLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvSavingLabel"
                        tools:text="2.297.000 ₫" />

                    <FrameLayout
                        android:id="@+id/flChartContainer"
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSaving"
                        app:layout_constraintVertical_bias="0.44">

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartSaving"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartIncomeSpent"
                            android:layout_width="98dp"
                            android:layout_height="98dp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <View
                        android:id="@+id/vPointerSavingPurple"
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="-8dp"
                        android:background="@drawable/dashed_line_v"
                        android:backgroundTint="@color/saving_blue_accent"
                        android:layerType="software"
                        app:layout_constraintBottom_toTopOf="@id/flChartContainer"
                        app:layout_constraintEnd_toEndOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="@id/flChartContainer" />

                    <View
                        android:id="@+id/pointerHeadSavingPurple"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/pointer_dot"
                        android:backgroundTint="@color/saving_blue_accent"
                        app:layout_constraintBottom_toTopOf="@id/vPointerSavingPurple"
                        app:layout_constraintEnd_toEndOf="@id/vPointerSavingPurple"
                        app:layout_constraintStart_toStartOf="@id/vPointerSavingPurple" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BUDGET LIST HEADER CARD ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/ivExpandToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_up"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/btnAddBudget"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_nav"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/miniChartSpent"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/llTotalBudgeted"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/miniChartSpent"
                        app:layout_constraintStart_toEndOf="@id/ivExpandToggle"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:gravity="center"
                            android:text="@string/total_budgeted_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvListTotalBudgeted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="5.626.000 ₫" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llTotalSpent"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical|end"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnAddBudget"
                        app:layout_constraintStart_toEndOf="@id/miniChartSpent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:gravity="center"
                            android:text="@string/total_spent_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvListTotalSpent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="4.203.000 ₫" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryBudgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_category_budget" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
