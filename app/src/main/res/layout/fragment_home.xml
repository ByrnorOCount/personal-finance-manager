<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="100dp">

            <!-- ── TOP BAR ─────────────────────────────────────────── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    app:tint="?attr/colorOnBackground" />

                <TextView
                    android:id="@+id/tvDateRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_toEndOf="@id/btnMenu"
                    android:layout_toStartOf="@+id/llTopRightActions"
                    app:drawableEndCompat="@drawable/ic_arrow_downward"
                    android:drawablePadding="4dp"
                    app:drawableTint="?attr/colorOnBackground"
                    android:gravity="center"
                    android:text="@string/placeholder_date_range"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llTopRightActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnBackground" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications"
                        app:tint="?attr/colorOnBackground" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ── DASHBOARD CARD ────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dashboard_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <!-- Initial Balance row -->
                    <TextView
                        android:id="@+id/tvInitialBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/initial_balance_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvInitialBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvInitialBalanceLabel"
                        app:layout_constraintStart_toEndOf="@id/tvInitialBalanceLabel"
                        tools:text="6.000.000 ₫" />

                    <!-- LEFT COLUMN: Income + Budget -->
                    <TextView
                        android:id="@+id/tvTotalIncomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/total_income_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvInitialBalanceLabel" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/income_green_accent"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalIncomeLabel"
                        tools:text="6.500.000 ₫" />

                    <!-- Income progress bar (takes more width now) -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/incomeProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:progress="100"
                        app:indicatorColor="@color/income_green_accent"
                        app:layout_constraintEnd_toStartOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalIncome"
                        app:trackColor="@color/chart_gray_bg"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/tvProvisionalBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/provisional_balance_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/incomeProgress"
                        app:layout_constraintTop_toBottomOf="@id/incomeProgress" />

                    <TextView
                        android:id="@+id/tvProvisionalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/provisional_blue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvProvisionalBalanceLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvProvisionalBalanceLabel"
                        tools:text="874.000 ₫" />

                    <!-- Total Budgeted -->
                    <TextView
                        android:id="@+id/tvTotalBudgetedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/total_budgeted_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProvisionalBalance" />

                    <TextView
                        android:id="@+id/tvTotalBudgeted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/budget_purple_accent"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalBudgetedLabel"
                        tools:text="5.626.000 ₫" />

                    <!-- Budget progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/budgetProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:progress="30"
                        app:indicatorColor="@color/budget_yellow_accent"
                        app:layout_constraintEnd_toStartOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalBudgeted"
                        app:trackColor="@color/budget_purple_accent"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/tvRemainingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/remaining_to_spend_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/budgetProgress"
                        app:layout_constraintTop_toBottomOf="@id/budgetProgress" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/budget_yellow_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvRemainingLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvRemainingLabel"
                        tools:text="1.423.000 ₫" />

                    <!-- RIGHT COLUMN: Saving label + Donut chart -->
                    <TextView
                        android:id="@+id/tvSavingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saving_label"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/flChartContainer"
                        app:layout_constraintStart_toStartOf="@id/flChartContainer"
                        app:layout_constraintTop_toTopOf="@id/tvTotalIncomeLabel" />

                    <TextView
                        android:id="@+id/tvSaving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/saving_blue_accent"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvSavingLabel"
                        app:layout_constraintStart_toStartOf="@id/tvSavingLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvSavingLabel"
                        tools:text="2.297.000 ₫" />

                    <!-- Main donut chart (2-ring composition) -->
                    <FrameLayout
                        android:id="@+id/flChartContainer"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSaving">

                        <!-- Outer ring: Saving -->
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartSaving"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Inner ring: Income Spent -->
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chartIncomeSpent"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BUDGET LIST HEADER CARD ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dashboard_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <!-- Expand/collapse toggle -->
                    <ImageView
                        android:id="@+id/ivExpandToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_up"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/dashboard_text_secondary" />

                    <LinearLayout
                        android:id="@+id/llTotalBudgeted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivExpandToggle"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_budgeted_label"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvListTotalBudgeted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="5.626.000 ₫" />
                    </LinearLayout>

                    <!-- Mini donut chart centered -->
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/miniChartSpent"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/llTotalSpent"
                        app:layout_constraintStart_toEndOf="@id/llTotalBudgeted"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/llTotalSpent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnAddBudget"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_spent_label"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvListTotalSpent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="4.203.000 ₫" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnAddBudget"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_nav"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/dashboard_text_secondary" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── CATEGORY BUDGET LIST ────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryBudgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_category_budget" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
