<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:checkable="false"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorPrimary"
    app:strokeColor="?attr/colorSurfaceVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- Category icon circle -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_cat_food"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/white"
            tools:backgroundTint="#7FB3D5" />

        <!-- Category name -->
        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btnAddTransaction"
            app:layout_constraintStart_toEndOf="@id/ivCategoryIcon"
            app:layout_constraintTop_toTopOf="@id/ivCategoryIcon"
            tools:text="salary" />

        <!-- Spent amount -->
        <LinearLayout
            android:id="@+id/llSpentInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/tvCategoryName"
            app:layout_constraintTop_toBottomOf="@id/tvCategoryName">

            <TextView
                android:id="@+id/tvSpentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="$50,000.00" />

            <TextView
                android:id="@+id/tvSpentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="2.5dp"
                android:text="@string/spent_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Add button top-right -->
        <ImageView
            android:id="@+id/btnAddTransaction"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:contentDescription="Edit"
            android:padding="5dp"
            android:src="@drawable/ic_wrench"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <!-- Progress bar -->
        <FrameLayout
            android:id="@+id/categoryProgressContainer"
            android:layout_width="0dp"
            android:layout_height="9dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_bar_full"
            android:backgroundTint="?attr/colorSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/linearLayout"
            app:layout_constraintStart_toStartOf="@id/ivCategoryIcon"
            app:layout_constraintTop_toBottomOf="@id/llSpentInfo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:id="@+id/categoryProgressIndicator"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="25"
                    android:background="@drawable/bg_bar_full"
                    android:backgroundTint="?attr/colorPrimary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Remaining amount -->
        <TextView
            android:id="@+id/tvRemainingAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/income_green_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/ivCategoryIcon"
            app:layout_constraintTop_toBottomOf="@id/categoryProgressContainer"
            tools:text="$150,000.00 Left" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvRemainingAmount"
            app:layout_constraintStart_toEndOf="@id/tvRemainingAmount"
            app:layout_constraintTop_toTopOf="@id/tvRemainingAmount"
            tools:text=" · 25.00%" />

        <!-- Note -->
        <TextView
            android:id="@+id/tvNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/linearLayout"
            app:layout_constraintStart_toStartOf="@id/ivCategoryIcon"
            app:layout_constraintTop_toBottomOf="@id/tvRemainingAmount"
            tools:text="This is a note for this category budget."
            tools:visibility="visible" />

        <!-- Goal section -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAddTransaction">

            <TextView
                android:id="@+id/tvBudgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/budgeted_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBudgetAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="end"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$200,000.00" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
