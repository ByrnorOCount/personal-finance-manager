<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorExpense"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- Section label row -->
        <ImageView
            android:id="@+id/ivExpandToggle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_up"
            app:layout_constraintBottom_toBottomOf="@id/tvSectionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSectionLabel"
            app:tint="?attr/colorExpense" />

        <TextView
            android:id="@+id/tvSectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.06"
            android:text="EXPENSES"
            android:textColor="?attr/colorExpense"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnAddExpense"
            app:layout_constraintStart_toEndOf="@id/ivExpandToggle"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnAddExpense"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="?attr/colorExpense"
            android:contentDescription="Add Expense Category"
            android:padding="5dp"
            android:src="@drawable/ic_add_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnExpense" />

        <LinearLayout
            android:id="@+id/llTotalBudgetedInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/expenseProgressChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSectionLabel">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Budgeted"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalBudgetedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="$5,000.00" />
        </LinearLayout>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/expenseProgressChart"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@id/llTotalBudgetedInfo"
            app:layout_constraintEnd_toStartOf="@id/llTotalSpentInfo"
            app:layout_constraintStart_toEndOf="@id/llTotalBudgetedInfo"
            app:layout_constraintTop_toTopOf="@id/llTotalBudgetedInfo" />

        <LinearLayout
            android:id="@+id/llTotalSpentInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/llTotalBudgetedInfo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/expenseProgressChart"
            app:layout_constraintTop_toTopOf="@id/llTotalBudgetedInfo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Total Spent"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalSpentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="end"
                android:textColor="?attr/colorExpense"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="$0.00" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
